ault": null, "name": "classtar", "type": ["null", "float"]}, {"doc": "Distance to nearest edge in image [pixels]", "default": null, "name": "mindtoedge", "type": ["null", "float"]}, {"doc": "Difference: diffmaglim - magap [mag]", "default": null, "name": "magfromlim", "type": ["null", "float"]}, {"doc": "Ratio: difffwhm / fwhm", "default": null, "name": "seeratio", "type": ["null", "float"]}, {"doc": "Windowed profile RMS afloat major axis from SExtractor [pixels]", "default": null, "name": "aimage", "type": ["null", "float"]}, {"doc": "Windowed profile RMS afloat minor axis from SExtractor [pixels]", "default": null, "name": "bimage", "type": ["null", "float"]}, {"doc": "Ratio: aimage / fwhm", "default": null, "name": "aimagerat", "type": ["null", "float"]}, {"doc": "Ratio: bimage / fwhm", "default": null, "name": "bimagerat", "type": ["null", "float"]}, {"doc": "Ratio: aimage / bimage", "default": null, "name": "elong", "type": ["null", "float"]}, {"doc": "number of negative pixels in a 5 x 5 pixel stamp", "default": null, "name": "nneg", "type": ["null", "int"]}, {"doc": "number of prior-tagged bad pixels in a 5 x 5 pixel stamp", "default": null, "name": "nbad", "type": ["null", "int"]}, {"doc": "RealBogus quality score from Random Forest classifier; range is 0 to 1 where closer to 1 is more reliable", "default": null, "name": "rb", "type": ["null", "float"]}, {"doc": "distance to nearest known solar system object if exists within 30 arcsec [arcsec]", "default": null, "name": "ssdistnr", "type": ["null", "float"]}, {"doc": "magnitude of nearest known solar system object if exists within 30 arcsec (usually V-band from MPC archive) [mag]", "default": null, "name": "ssmagnr", "type": ["null", "float"]}, {"doc": "name of nearest known solar system object if exists within 30 arcsec (from MPC archive)", "default": null, "name": "ssnamenr", "type": ["null", "string"]}, {"doc": "Ratio: sum(pixels) / sum(|pixels|) in a 5 x 5 pixel stamp where stamp is first median-filtere