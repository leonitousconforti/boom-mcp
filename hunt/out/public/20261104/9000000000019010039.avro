mes input candidate position fell on any field and readout-channel going back to beginning of survey", "name": "ncovhist", "type": "int"}, {"doc": "Earliest Julian date of epoch corresponding to ndethist [days]", "default": null, "name": "jdstarthist", "type": ["null", "double"]}, {"doc": "Latest Julian date of epoch corresponding to ndethist [days]", "default": null, "name": "jdendhist", "type": ["null", "double"]}, {"doc": "Peak-pixel signal-to-noise ratio in point source matched-filtered detection image", "default": null, "name": "scorr", "type": ["null", "double"]}, {"doc": "1 => candidate is from a Target-of-Opportunity (ToO) exposure; 0 => candidate is from a non-ToO exposure", "default": null, "name": "tooflag", "type": ["null", "int"]}, {"doc": "Object ID of closest source from PS1 catalog; if exists within 30 arcsec", "default": null, "name": "objectidps1", "type": ["null", "long"]}, {"doc": "Object ID of second closest source from PS1 catalog; if exists within 30 arcsec", "default": null, "name": "objectidps2", "type": ["null", "long"]}, {"doc": "g-band PSF-fit magnitude of second closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "sgmag2", "type": ["null", "float"]}, {"doc": "r-band PSF-fit magnitude of second closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "srmag2", "type": ["null", "float"]}, {"doc": "i-band PSF-fit magnitude of second closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "simag2", "type": ["null", "float"]}, {"doc": "z-band PSF-fit magnitude of second closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "szmag2", "type": ["null", "float"]}, {"doc": "Star/Galaxy score of second closest source from PS1 catalog; if exists within 30 arcsec: 0 <= sgscore <= 1 where closer to 1 implies higher likelihood of being a star", "default": null, "name": "sgscore2", "type": ["null", "float"]}, {"doc": "Distance to second closest source from PS1 catalog; if exists within 30 arcsec [arcsec]", "default": null, "name": "distpsnr2", "type": ["null", "float"]}, {"doc": "Object ID of third closest source from PS1 catalog; if exists within 30 arcsec", "default": null, "name": "objectidps3", "type": ["null", "long"]}, {"doc": "g-band PSF-fit magnitude of third closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "sgmag3", "type": ["null", "float"]}, {"doc": "r-band PSF-fit magnitude of third closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "srmag3", "type": ["null", "float"]}, {"doc": "i-band PSF-fit magnitude of third closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "simag3", "type": ["null", "float"]}, {"doc": "z-band PSF-fit magnitude of third closest source from PS1 catalog; if exists within 30 arcsec [mag]", "default": null, "name": "szmag3", "type": ["null", "float"]}, {"doc": "Star/Galaxy score of third closest source from PS1 catalog; if exists within 30 arcsec: 0 <= sgscore <= 1 where closer to 1 implies higher likelihood of being a star", "default": null, "name": "sgscore3", "type": ["null", "float"]}, {"doc": "Distance to third closest source from PS1 catalog; if exists within 30 arcsec [arcsec]", "default": null, "name": "distpsnr3", "type": ["null", "float"]}, {"doc": "Number of source matches from PS1 catalog falling within 30 arcsec", "name": "nmtchps", "type": "int"}, {"doc": "Processing ID for reference image to facilitate archive retrieval", "name": "rfid", "type": "long"}, {"doc": "Observation Julian date of earliest exposure used to generate reference image [days]", "name": "jdstartref", "type": "double"}, {"doc": "Observation Julian date of latest exposure used to generate reference image [days]", "name": "jdendref", "type": "double"}, {"doc": "Number of frames (epochal images) used to generate reference image"